---
interface Props {
    title: string;
}

const { title } = Astro.props;
---

<html
    lang="en"
    class="bg-zinc-100 dark:bg-zinc-900 text-zinc-950 dark:text-zinc-50"
>
    <head>
        <meta charset="utf-8" />
        <link
            rel="icon"
            type="image/svg+xml"
            href="https://www.gravatar.com/avatar/0f0faaf1a2234983e68a4de9d21bd262"
        />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <base target="_blank" />

        <script
            defer
            data-domain="lgk-productions.com"
            src="https://plausible.shortdev.de/js/script.js"></script>
    </head>
    <body class="prose dark:prose-invert mx-auto p-3">
        <header class="flex flex-row items-center gap-3">
            <img
                src="https://www.gravatar.com/avatar/0f0faaf1a2234983e68a4de9d21bd262?d=404"
                class="m-2 p-2 rounded-full w-24 h-24 bg-zinc-200 dark:bg-zinc-800 border border-zinc-500"
                alt="LGK Productions logo"
            />
            <h1 class="m-0">{title}</h1>
        </header>

        <slot />
    </body>
</html>
