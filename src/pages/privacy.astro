---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Privacy Policy">
    <p>
        <em>Last updated:</em> 27.10.2026
    </p>
    <p>
        This privacy policy applies to this website and LGK Productions games
        published to the Google Play Store and itch.io.
    </p>
    <h2 id="data-collection">Data collection</h2>
    <h3 id="data-website">Website</h3>
    <p>
        This web page captures basic and anonymised traffic analysis using <a
            href="https://plausible.io/"
            target="_blank">Plausible Analytics</a
        >.
    </p>
    <h3 id="data-games">Games</h3>
    <p>
        LGK Productions does not add analysis or tracking features to its games.
        However, third-party services used to create or distribute these games
        may collect additional data.
    </p>
    <p>
        For games developed with the Unity® game engine, Unity Technologies may
        collect analysis data regarding their engine: See Unity's <a
            href="https://unity.com/legal/privacy-policy"
            target="_blank">Privacy Policy</a
        >.
    </p>
    <p>
        If you have downloaded a game through the Google Play Store, Google may
        collect analytics data: <a
            href="https://policies.google.com/privacy"
            target="_blank">Google Privacy & Terms</a
        >.
    </p>
    <h2 id="contact">Contact</h2>
    <p>If you have any questions, You can contact us:</p>
    <ul>
        <li>
            By email: <a href="mailto:contact@lgk-productions.com"
                >contact@lgk-productions.com</a
            >
        </li>
    </ul>
</Layout>
