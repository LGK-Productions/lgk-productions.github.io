---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";

const gameIds = [5094689, 4511947, 3962062, 3028096, 2158248, 1663329];
---

<Layout title="LGK Productions">
  <p>Hi there 👋</p>

  <h2>Links</h2>
  <a
    href="https://github.com/LGK-Productions"
    class="flex flex-row items-center gap-2"
  >
    <Icon name="tabler:brand-github" size={30} />
    GitHub
  </a>
  <a
    href="https://lgk-productions.itch.io/"
    class="flex flex-row items-center gap-2"
  >
    <Icon name="tabler:brand-itch" size={30} />
    Itch
  </a>
  <a
    href="https://fdroid.link/#https://fdroid.lgk-productions.com/fdroid/repo?fingerprint=B5143295F441FBAF2701C286A1C4D31F7BDF41607397ED9B2F6AA81B09B4C00A"
    class="flex flex-row items-center gap-2"
  >
    <Icon name="tabler:brand-android" size={30} />
    F-Droid
  </a>

  <h2>Games</h2>
  <section class="flex flex-col gap-3">
    {
      gameIds.map((id) => (
        <iframe
          src={`https://itch.io/embed/${id}?bg_color=18181b&fg_color=fff&link_color=542f03&border_color=18181b`}
          class="w-full"
          allowtransparency="true"
        />
      ))
    }
  </section>
</Layout>
